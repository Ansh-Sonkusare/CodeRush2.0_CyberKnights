# Copy to .env and fill in values. .env is gitignored — never commit real keys.
# Every service reads config via packages/config loadConfig() — not process.env directly.

# ── Network ────────────────────────────────────────────────────────────────────
# "testnet" is the only accepted value. Mainnet is blocked at boot.
NETWORK=testnet
FACILITATOR_URL=https://facilitator.goplausible.xyz

# ── Service ports ─────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
ORCHESTRATOR_PORT=4010
PROVIDERS_PORT=4020
LEDGER_PORT=4030
PLANNER_PORT=4040

# ── Mock provider ports (comma-separated name=port pairs) ─────────────────────
# These are started by service-providers on demand.
MOCK_PROVIDER_PORTS=search-a=4101,lingo-b=4102,fastrank-c=4103
ADVERSARIAL_PROVIDER_PORTS=evil-search=4104,evil-extract=4105,evil-rank=4106

# ── LLM configuration ─────────────────────────────────────────────────────────
# LLM_PROVIDER: gemini | openai-compatible | ollama
# Inferred from keys if unset: GEMINI_API_KEY → gemini, else openai-compatible, else ollama
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_BASE_URL=https://openrouter.ai/api/v1/
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# LLM_MODEL=gemini-3.5-flash
# LLM_MODEL=openrouter/free
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ── Zerion ────────────────────────────────────────────────────────────────────
ZERION_API_KEY=

# ── Ledger ─────────────────────────────────────────────────────────────────────
# SQLite file path for the append-only ledger store (gateway + orchestrator share it).
LEDGER_PATH=.data/ledger.db

# ── Legacy per-backend overrides (used if LLM_PROVIDER unset) ────────────────
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder
