# Copy to .env.local and fill in the values you want to use.
# .env.local is gitignored — never commit real keys.
#
# The planner backend (src/planner/planner.ts) is selected by LLM_PROVIDER:
#   gemini | openai-compatible | ollama
# If LLM_PROVIDER is unset it is inferred from which key is present:
#   GEMINI_API_KEY -> gemini ; GROQ_API_KEY/OPENAI_API_KEY -> openai-compatible ; else ollama

# --- Unified LLM configuration (the LLM_* vars win over the legacy fallbacks) ---
LLM_PROVIDER="openai-compatible"
LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_BASE_URL="https://openrouter.ai/api/v1/"
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_BASE_URL="http://localhost:11434"
LLM_API_KEY=""
LLM_MODEL="llama-3.3-70b-versatile"
# LLM_MODEL="openrouter/free"
# LLM_MODEL="gemini-3.5-flash"
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# --- Legacy per-backend overrides (used when LLM_PROVIDER is unset or as LLM_* fallbacks) ---
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.5-flash"
# GROQ_API_KEY=""
# OPENAI_API_KEY=""
# OPENAI_MODEL=""
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="qwen2.5-coder"
